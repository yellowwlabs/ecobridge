{
  "name": "@ecobridge/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && cp src/db/*.sql dist/db/",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "db:import-collections": "tsx src/db/importCollections.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
