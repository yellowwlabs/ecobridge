# --- Database (required) ---
# Local:   postgresql://postgres:postgres@localhost:5432/ecobridge
# Managed: postgresql://user:pass@host/db  (set DATABASE_SSL=true)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecobridge
DATABASE_SSL=false

# --- Auth (required) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d

# --- Server ---
PORT=3001

# --- Gemini (optional; AI endpoints fall back to price-board answers without it) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- AI endpoint rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=50
